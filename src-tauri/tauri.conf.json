{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MenuForge",
  "version": "0.1.0",
  "identifier": "com.ducaoya.menuforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MenuForge · 右键菜单管理器",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "theme": "Dark",
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "licenseFile": "../LICENSE"
  }
}
