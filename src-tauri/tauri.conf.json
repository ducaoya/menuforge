{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MenuForge",
  "version": "0.1.0",
  "identifier": "com.ducaoya.menuforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MenuForge · 右键菜单管理器",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d0f13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
